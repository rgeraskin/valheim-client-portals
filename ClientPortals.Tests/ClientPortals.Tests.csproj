<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests of the parts that don't need the game running: the atlas (merge, removal, serialization) and
       the destination list (filters, order, selection). The plugin and Unity's core module load into .NET as plain libraries. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <!-- the plugin targets .NET Framework 4.6.2; its types load fine here -->
    <NoWarn>$(NoWarn);NU1702;MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(VALHEIM_DIR)</ValheimDir>
    <ManagedDir Condition="Exists('$(ValheimDir)/valheim.app/Contents/Resources/Data/Managed')">$(ValheimDir)/valheim.app/Contents/Resources/Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == '' And Exists('$(ValheimDir)/valheim_server_Data/Managed')">$(ValheimDir)/valheim_server_Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(ValheimDir)/valheim_Data/Managed</ManagedDir>
    <BepInExDir>$(ValheimDir)/BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ClientPortals/ClientPortals.csproj" />
    <!-- copied next to the tests so they load (never shipped) -->
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)/UnityEngine.dll" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)/UnityEngine.IMGUIModule.dll" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)/UnityEngine.TextRenderingModule.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)/UnityEngine.UI.dll" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)/UnityEngine.UIModule.dll" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)/Unity.TextMeshPro.dll" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)/Unity.InputSystem.dll" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)/core/0Harmony.dll" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)/core/BepInEx.dll" />
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)/assembly_valheim.dll" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)/assembly_utils.dll" />
    <Reference Include="assembly_guiutils" HintPath="$(ManagedDir)/assembly_guiutils.dll" />
    <Reference Include="gui_framework" HintPath="$(ManagedDir)/gui_framework.dll" />
  </ItemGroup>

</Project>
